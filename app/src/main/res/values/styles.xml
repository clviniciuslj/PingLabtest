<resources>
    <!-- Tema "noite": grafite neutro com azul de destaque (paleta medida no WiFiman). -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="android:colorAccent">#4896FF</item>
        <item name="android:windowBackground">#111215</item>
        <item name="android:colorBackground">#111215</item>
        <item name="android:statusBarColor">#111215</item>
        <item name="android:navigationBarColor">#111215</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <!-- Tema "dia". -->
    <style name="AppTheme.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="android:colorAccent">#0064DC</item>
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="android:colorBackground">#F2F2F7</item>
        <item name="android:statusBarColor">#F2F2F7</item>
        <item name="android:navigationBarColor">#F2F2F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/AppDialog.Light</item>
    </style>

    <style name="AppDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="android:colorAccent">#4896FF</item>
        <item name="android:windowBackground">@drawable/dialog_bg_dark</item>
        <item name="android:textColorPrimary">#FAFBFF</item>
        <item name="android:textColorSecondary">#B8B9BE</item>
    </style>

    <style name="AppDialog.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="android:colorAccent">#0064DC</item>
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:textColorPrimary">#111215</item>
        <item name="android:textColorSecondary">#6E717A</item>
    </style>
</resources>
